{
  "name": "dsh-better-trajectory",
  "version": "0.3.6",
  "description": "Make the DeepSeek Harness trajectory queryable: role / kind / model / step fields, one inspector for every record, and the raw session log itself.",
  "license": "MIT",
  "type": "module",
  "main": "index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.mjs && node --check lib/client.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "verify": "npm run test && npm run typecheck && npm run check:fork && npm run build && npm run check",
    "check:fork": "node scripts/check-fork.mjs"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@types/react": "^18.3.12",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.33",
    "postcss-modules": "^9.0.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "trajectory",
    "observability",
    "debugging",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlln/dsh-better-trajectory.git"
  },
  "author": "vlln",
  "publishConfig": {
    "access": "public"
  }
}
